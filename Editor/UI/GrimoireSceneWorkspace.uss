.grimoire-scene {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background-color: #27282e;
    color: #e7e7ed;
    font-size: 13px;
}
.grimoire-scene.light { background-color: #f0f0f2; color: #24252b; }
.grimoire-scene .scene-titlebar { padding: 17px 20px 12px; align-items: center; }
.grimoire-scene .scene-title-text { flex-grow: 1; min-width: 0; }
.grimoire-scene .scene-title { font-size: 21px; -unity-font-style: bold; }
.grimoire-scene .scene-muted { color: #aeb0bb; font-size: 12px; white-space: normal; }
.grimoire-scene.light .scene-muted { color: #666873; }
.grimoire-scene .scene-titlebar .unity-button { margin-left: 6px; }
.grimoire-scene .scene-summary {
    margin-left: 15px; margin-right: 15px; margin-bottom: 10px;
    padding: 12px; align-items: center; background-color: #303138;
    border-left-width: 3px; border-left-color: #7959cb;
}
.grimoire-scene.light .scene-summary { background-color: #e8e5ef; }
.grimoire-scene .scene-summary-text { flex-grow: 1; min-width: 0; white-space: normal; }
.grimoire-scene .scene-summary-title { -unity-font-style: bold; margin-bottom: 3px; }
.grimoire-scene .scene-summary-badges { align-items: center; flex-wrap: wrap; }
.grimoire-scene .scene-language-badge, .grimoire-scene .scene-sync-badge { font-size: 10px; padding: 5px; margin-left: 6px; background-color: #41434c; }
.grimoire-scene .scene-sync-badge { color: #8be0b0; background-color: #23523e; }
.grimoire-scene.light .scene-sync-badge { color: #1d6b48; background-color: #d6efe0; }
.grimoire-scene .scene-searchbar { align-items: center; padding-left: 20px; padding-right: 20px; padding-top: 7px; padding-bottom: 14px; }
.grimoire-scene .scene-search { flex-grow: 1; min-width: 90px; }
.grimoire-scene .scene-searchbar .unity-button { margin-left: 6px; }
.grimoire-scene .scene-group-popup { display: none; }
.grimoire-scene .scene-filters { min-width: 110px; }
.grimoire-scene .scene-filters.selected { background-color: #7050c9; color: white; }
.grimoire-scene .scene-panes {
    flex-grow: 1; min-height: 0;
    border-top-width: 1px; border-top-color: #44454e;
}
.grimoire-scene.light .scene-panes { border-top-color: #d0d0d5; }
.grimoire-scene .scene-pane-heading {
    min-height: 32px; padding-left: 12px; padding-top: 8px;
    color: #a9abb8; font-size: 11px; -unity-font-style: bold;
    background-color: #2b2c33;
}
.grimoire-scene.light .scene-pane-heading { background-color: #e4e4e7; color: #676973; }
.grimoire-scene .scene-group-pane {
    width: 195px; flex-shrink: 0; min-height: 0;
    background-color: #212228;
    border-right-width: 1px; border-right-color: #41424a;
}
.grimoire-scene.light .scene-group-pane { background-color: #e9e9ec; border-right-color: #d0d0d5; }
.grimoire-scene .scene-group-row { min-height: 32px; align-items: center; padding-right: 9px; }
.grimoire-scene .scene-group-row:hover { background-color: #32333d; }
.grimoire-scene.light .scene-group-row:hover { background-color: #dad6e5; }
.grimoire-scene .scene-group-row.selected { background-color: #403653; border-left-width: 2px; border-left-color: #aa8bfa; }
.grimoire-scene .scene-group-row.unity-selected { -unity-font-style: bold; color: #ffffff; }
.grimoire-scene.light .scene-group-row.selected { background-color: #ded2f5; border-left-color: #704fc4; }
.grimoire-scene.light .scene-group-row.unity-selected { color: #3b2867; }
.grimoire-scene .scene-group-name { flex-grow: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.grimoire-scene .scene-group-count { color: #aaacb7; font-size: 11px; }
.grimoire-scene.light .scene-group-count { color: #777982; }
.grimoire-scene .scene-list-pane { flex-grow: 1; min-width: 0; min-height: 0; border-right-width: 1px; border-right-color: #44454e; }
.grimoire-scene.light .scene-list-pane { border-right-color: #d0d0d5; }
.grimoire-scene .scene-list { flex-grow: 1; min-height: 0; background-color: #27282e; }
.grimoire-scene .scene-list-hint { min-height: 31px; padding-left: 12px; padding-top: 7px; color: #a9abb8; font-size: 11px; background-color: #222329; }
.grimoire-scene.light .scene-list-hint { background-color: #ececef; color: #676973; }
.grimoire-scene.light .scene-list { background-color: #f3f3f5; }
.grimoire-scene .scene-item-row { height: 62px; align-items: center; padding-left: 10px; padding-right: 9px; border-bottom-width: 1px; border-bottom-color: #41424a; }
.grimoire-scene .scene-item-row.selected { background-color: #403653; border-left-width: 3px; border-left-color: #aa8bfa; padding-left: 7px; }
.grimoire-scene.light .scene-item-row { border-bottom-color: #dedee2; }
.grimoire-scene.light .scene-item-row.selected { background-color: #ded2f5; border-left-color: #704fc4; }
.grimoire-scene .scene-item-main { flex-grow: 1; min-width: 0; }
.grimoire-scene .scene-item-title { align-items: center; min-width: 0; }
.grimoire-scene .scene-item-name { -unity-font-style: bold; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.grimoire-scene .scene-item-badge { margin-left: 6px; padding-left: 5px; padding-right: 5px; padding-top: 2px; padding-bottom: 2px; font-size: 10px; -unity-font-style: bold; }
.grimoire-scene .scene-item-badge.object { color: #b6f0ce; background-color: #24523b; }
.grimoire-scene .scene-item-badge.text { color: #b5d9f6; background-color: #25506a; }
.grimoire-scene .scene-item-badge.unlinked { color: #e0c5d2; background-color: #51414b; }
.grimoire-scene .scene-item-meta { color: #a7a9b5; font-size: 11px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.grimoire-scene.light .scene-item-meta { color: #6b6d76; }
.grimoire-scene .scene-item-side { align-items: flex-end; min-width: 85px; }
.grimoire-scene .scene-item-type { font-size: 11px; color: #e7e7ed; }
.grimoire-scene.light .scene-item-type { color: #33343a; }
.grimoire-scene .scene-item-status { font-size: 10px; color: #a7a9b5; }
.grimoire-scene .scene-detail-pane { width: 480px; flex-shrink: 0; min-width: 0; min-height: 0; background-color: #303138; }
.grimoire-scene.light .scene-detail-pane { background-color: #f8f8fa; }
.grimoire-scene .scene-detail-scroll { flex-grow: 1; min-height: 0; }
.grimoire-scene .scene-detail-content { padding: 15px; }
.grimoire-scene .scene-detail-kind { color: #bda7f1; font-size: 10px; -unity-font-style: bold; }
.grimoire-scene.light .scene-detail-kind { color: #6747b4; }
.grimoire-scene .scene-detail-name { font-size: 16px; -unity-font-style: bold; margin-top: 2px; }
.grimoire-scene .scene-detail-key { color: #b5b6bf; margin-bottom: 8px; white-space: normal; }
.grimoire-scene.light .scene-detail-key { color: #666873; }
.grimoire-scene .scene-actions { flex-wrap: wrap; margin-top: 6px; margin-bottom: 9px; }
.grimoire-scene .scene-actions .unity-button { margin-right: 5px; margin-bottom: 5px; }
.grimoire-scene .scene-link-card { margin-top: 9px; margin-bottom: 11px; padding: 13px; background-color: #3a3547; border-left-width: 3px; border-left-color: #a588ee; }
.grimoire-scene.light .scene-link-card { background-color: #eee7f8; }
.grimoire-scene .scene-link-title { align-items: center; margin-top: 5px; margin-bottom: 5px; }
.grimoire-scene .scene-link-name { -unity-font-style: bold; flex-grow: 1; }
.grimoire-scene .scene-linked-badge { font-size: 10px; padding: 3px; background-color: #24523b; color: #b6f0ce; }
.grimoire-scene .scene-detail-tabs { flex-wrap: wrap; border-bottom-width: 1px; border-bottom-color: #50515b; margin-bottom: 8px; }
.grimoire-scene .scene-detail-tab { margin-right: 3px; margin-bottom: 3px; border-left-width: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 2px; border-bottom-color: transparent; background-color: transparent; }
.grimoire-scene .scene-detail-tab.selected { color: #d9c8ff; border-bottom-color: #aa8bfa; -unity-font-style: bold; }
.grimoire-scene.light .scene-detail-tab.selected { color: #6747b4; border-bottom-color: #704fc4; }
.grimoire-scene .scene-section { margin-top: 17px; margin-bottom: 9px; padding-bottom: 6px; -unity-font-style: bold; border-bottom-width: 1px; border-bottom-color: #50515b; }
.grimoire-scene.light .scene-section { border-bottom-color: #d7d7dd; }
.grimoire-scene .scene-value-card { min-width: 0; margin-bottom: 7px; padding: 10px; background-color: #393a42; border-left-width: 2px; border-left-color: #615673; }
.grimoire-scene.light .scene-value-card { background-color: #ededf1; border-left-color: #b8a5d8; }
.grimoire-scene .scene-value-header { align-items: flex-start; min-width: 0; margin-bottom: 5px; }
.grimoire-scene .scene-value-name { flex-grow: 1; min-width: 0; -unity-font-style: bold; white-space: normal; }
.grimoire-scene .scene-value-type { flex-shrink: 0; margin-left: 7px; color: #bfaee7; font-size: 10px; }
.grimoire-scene.light .scene-value-type { color: #7053a4; }
.grimoire-scene .scene-value-text { min-width: 0; white-space: normal; }
.grimoire-scene .scene-value-card .unity-button { align-self: flex-start; margin-top: 6px; }
.grimoire-scene .scene-info { margin-top: 10px; padding: 9px; background-color: #39364b; border-left-width: 3px; border-left-color: #a588ee; white-space: normal; }
.grimoire-scene.light .scene-info { background-color: #eee7f8; border-left-color: #7654c8; }
.grimoire-scene .scene-primary { min-height: 30px; margin-top: 8px; background-color: #7050c9; color: white; }
.grimoire-scene .scene-titlebar .scene-primary { margin-top: 0; }
.grimoire-scene .scene-legacy-detail { flex-grow: 1; min-height: 140px; }
.grimoire-scene .scene-footer { min-height: 24px; padding-left: 10px; padding-top: 4px; background-color: #34353b; color: #a8abb6; font-size: 11px; }
.grimoire-scene.light .scene-footer { background-color: #e3e3e6; color: #63656e; }
.grimoire-scene.medium .scene-group-pane { width: 150px; }
.grimoire-scene.medium .scene-detail-pane { width: 360px; }
.grimoire-scene.compact .scene-group-pane { display: none; }
.grimoire-scene.compact .scene-group-popup { display: flex; }
.grimoire-scene.compact .scene-panes { flex-direction: column; }
.grimoire-scene.compact .scene-list-pane { height: 220px; flex-grow: 0; border-right-width: 0; border-bottom-width: 1px; border-bottom-color: #44454e; }
.grimoire-scene.compact .scene-detail-pane { width: auto; flex-grow: 1; }
.grimoire-scene.compact .scene-titlebar { flex-wrap: wrap; }
.grimoire-scene.compact .scene-title { font-size: 16px; }
.grimoire-scene.compact .scene-summary { flex-wrap: wrap; }
.grimoire-scene.compact .scene-summary-badges { margin-top: 6px; }
